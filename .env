# Environment variables for MotoGuardian

# Required for Google Maps integration in Non-OBD Dashboard
# Get an API Key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis/overview
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your key

# Optional: Google Maps Map ID for custom map styling (if you created one)
# https://developers.google.com/maps/documentation/javascript/cloud-based-map-styling
# If not provided, a default map style will be used.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=YOUR_MAP_ID_HERE

# Genkit/AI related environment variables (if needed for production deployment)
# GENKIT_ENV=production
# GOOGLE_API_KEY=YOUR_GOOGLE_AI_API_KEY_HERE
GOOGLE_GENAI_API_KEY=your key
